{
  "tasks": {
    "check": "deno check src/processors/*.ts src/*_test.ts src/lib/*_test.ts",
    "lint": "deno lint src",
    "fmt": "deno fmt --check src deno.json",
    "test": "deno test --allow-read --allow-write --allow-run src",
    "verify": "deno task check && deno task lint && deno task fmt && deno task test"
  },
  "imports": {
    "cheerio": "npm:cheerio@1.0.0-rc.12"
  }
}
